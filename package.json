{
  "name": "eslint-plugin-codebase-ai-rules",
  "version": "0.2.0",
  "private": true,
  "description": "Focused ESLint rules for AI-assisted codebases: comment discipline for JS/TS and broken relative links in Markdown.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "docs",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./markdown": {
      "import": "./src/markdown.mjs",
      "default": "./src/markdown.mjs"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node --check src/index.mjs && node --check src/markdown.mjs && node --check src/comment-discipline.mjs && node --check src/comment-directives.mjs && node --check src/comment-ranges.mjs && node --check src/no-broken-relative-links.mjs && node --check src/relative-links.mjs && node --check src/repository-paths.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "@eslint/markdown": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.70.1"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/JakubSzwajka/eslint-plugin-codebase-ai-rules.git"
  },
  "bugs": {
    "url": "https://github.com/JakubSzwajka/eslint-plugin-codebase-ai-rules/issues"
  },
  "homepage": "https://github.com/JakubSzwajka/eslint-plugin-codebase-ai-rules"
}
